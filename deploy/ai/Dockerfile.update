# Incremental release from a locally verified compatible AI image; clean builds use ai-service/Dockerfile.
ARG BASE_IMAGE=shopagent-ai:dev
FROM ${BASE_IMAGE}
WORKDIR /app
COPY --chown=10001:10001 ai-service/requirements*.txt ./
COPY --chown=10001:10001 ai-service/*.py ./
COPY --chown=10001:10001 ai-service/knowledge/ ./knowledge/
RUN python -m pip check && python -c "from importlib.metadata import version; from pathlib import Path; pins=[line.split('==',1) for p in Path('.').glob('requirements*.txt') for raw in p.read_text().splitlines() if (line:=raw.split('#',1)[0].strip()) and '==' in line]; bad=[name for name,want in pins if version(name)!=want]; assert not bad, 'Base image dependency mismatch: '+str(bad); print('Pinned runtime dependencies verified:',len(pins))"
